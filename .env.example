# Production domain. Optional on Vercel (it uses VERCEL_PROJECT_PRODUCTION_URL automatically).
SITE_URL=https://www.your-domain.in

# Neon Postgres connection string for leads. Leave empty locally to use the built-in PGlite database in .data/.
DATABASE_URL=

# Secret used to hash visitor network addresses for rate limiting. Use a long random string in production.
LEAD_IP_HASH_SALT=change-me
